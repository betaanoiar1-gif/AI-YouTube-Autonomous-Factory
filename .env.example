# =============================================================================
# AI YouTube Autonomous Factory — environment configuration (EXAMPLE ONLY)
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or any real secret to Git.
#
# Configuration layers (see docs/architecture.md):
#   1. Runtime secrets      -> environment variables only (this file's .env copy)
#   2. Provider configuration -> CLEANAPIS_* variables below
#   3. Application config   -> APP_* / DATABASE_URL / ... below
#   4. Project configuration -> per-project JSON stored in the database
# =============================================================================

# --- Runtime secrets ---------------------------------------------------------
# CleanAPIs API key (https://cleanapis.com). Keys start with `cc_`.
# The application reads this from the environment; it is never hard-coded,
# never logged, and never written to the repository.
# (The variable name is matched case-insensitively; CLEANAPIS_API_KEY also works.)
cleanapis_API_KEY=cc_replace_with_your_real_key

# YouTube Data API v3 key (Phase 1 discovery). Create it in the Google Cloud
# Console (APIs & Services -> Credentials). The application reads it from the
# environment only; it is never hard-coded, never logged, and never written to
# the repository. (Matched case-insensitively; YOUTUBE_API_KEY also works.)
youtube_API_KEY=replace_with_your_google_api_key

# --- Provider configuration (CleanAPIs) --------------------------------------
# Verified default endpoint (OpenAI-compatible): https://cleanapis.com/v1
# Only override if CleanAPIs publishes a different endpoint.
CLEANAPIS_BASE_URL=https://cleanapis.com/v1
# Default model used for LLM calls. Leave empty to require an explicit model
# per request, or to let the connectivity test pick the cheapest listed model.
CLEANAPIS_MODEL=
# Request timeout / retry policy for provider calls.
CLEANAPIS_TIMEOUT_SECONDS=120
CLEANAPIS_MAX_RETRIES=3
# Response cache (deduplication of deterministic requests).
CLEANAPIS_CACHE_ENABLED=true
CLEANAPIS_CACHE_TTL_SECONDS=86400
# Per-job request budgets (cost control).
CLEANAPIS_BUDGET_MAX_REQUESTS_PER_JOB=1000
CLEANAPIS_BUDGET_MAX_TOTAL_TOKENS_PER_JOB=5000000

# --- Application configuration ------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./storage/factory.db
ARTIFACT_STORAGE_DIR=./storage/artifacts
ARTIFACT_SCHEMAS_DIR=./schemas/artifacts
API_HOST=0.0.0.0
API_PORT=8080

# Job system retry policy (exponential backoff: base * 2^(attempts-1), capped).
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=3600
