{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/publish_package.schema.json",
  "title": "PublishPackage",
  "description": "publishing -> publish package artifact: title, description, tags, and thumbnail concept.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "title",
    "description",
    "thumbnail_concept"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "default": "en"
    },
    "thumbnail_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "text_overlay": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scheduled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
