{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/evidence.schema.json",
  "title": "EvidenceItem",
  "description": "evidence contract: a structured piece of evidence extracted from a source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_id",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "passage": {
      "type": "string",
      "maxLength": 2000,
      "default": ""
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "predicate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "value_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    }
  }
}
