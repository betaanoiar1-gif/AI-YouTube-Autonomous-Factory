{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/content_brief.schema.json",
  "title": "ContentBrief",
  "description": "Original content strategy derived from an opportunity and its research report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "opportunity_id",
    "title",
    "angle",
    "target_audience",
    "estimated_duration_seconds"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$",
      "default": "1.0.0"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "angle": {
      "type": "string",
      "minLength": 1
    },
    "target_audience": {
      "type": "string",
      "minLength": 1
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_gaps_addressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "research_report_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "central_promise": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "audience_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "originality_angle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "evidence_backed_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceBackedPoint"
      }
    },
    "unresolved_claims_to_avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intended_tone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidenceBackedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$",
          "default": "1.0.0"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
