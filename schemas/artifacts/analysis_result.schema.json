{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/analysis_result.schema.json",
  "title": "AnalysisResult",
  "description": "analysis -> analysis artifact: aggregate performance metrics, per-video evidence, and content patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "project_id",
    "video_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "video_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_views": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "average_views": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "top_performer_video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "supporting_video_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "pattern_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          }
        }
      },
      "default": []
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "video_id",
          "channel_id",
          "title"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "video_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "channel_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "views": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "likes": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "comments": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "age_days": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "views_per_day": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "engagement_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "comments_per_1000_views": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "channel_average_views": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "channel_relative_performance": {
            "type": [
              "number",
              "null"
            ]
          },
          "sub_scores": {
            "type": "object",
            "default": {}
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          }
        }
      },
      "default": []
    },
    "median_views": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "channel_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "competition": {
      "type": "object",
      "default": {}
    },
    "scoring": {
      "type": "object",
      "default": {}
    },
    "source_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  }
}
