{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/analysis_result.schema.json",
  "title": "AnalysisResult",
  "description": "analysis -> analysis artifact: aggregate performance metrics and content patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "project_id",
    "video_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "video_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_views": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "average_views": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "top_performer_video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "supporting_video_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          }
        }
      }
    }
  }
}
