{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/opportunity_list.schema.json",
  "title": "OpportunityList",
  "description": "opportunity -> opportunity artifact: structured, evidence-based original content opportunities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_list_id",
    "project_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "opportunity_list_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "topic",
          "score",
          "rationale"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "content_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "opportunity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "audience_question": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "supporting_video_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "demand_signals": {
            "type": "object",
            "default": {}
          },
          "competition_signals": {
            "type": "object",
            "default": {}
          },
          "novelty_rationale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "recommended_angle": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      },
      "default": []
    },
    "source_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "label",
          "saturation"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "cluster_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "video_count": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "total_views": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "average_views": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "saturation": {
            "type": "string",
            "maxLength": 32,
            "default": "balanced"
          },
          "representative_video_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    }
  }
}
