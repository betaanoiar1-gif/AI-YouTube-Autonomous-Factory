{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/narrative_outline.schema.json",
  "title": "NarrativeOutline",
  "description": "A structured narrative arc with traceable factual claims; not a script.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline_id",
    "brief_id",
    "opportunity_id",
    "title",
    "beats",
    "estimated_duration_seconds"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$",
      "default": "1.0.0"
    },
    "outline_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "brief_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/narrativeBeat"
      }
    },
    "estimated_duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "source_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "narrativeBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "index",
        "beat_type",
        "title",
        "purpose"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$",
          "default": "1.0.0"
        },
        "beat_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "beat_type": {
          "type": "string",
          "enum": [
            "hook",
            "setup",
            "escalation",
            "turning_point",
            "resolution",
            "final_insight"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
