{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/research_plan.schema.json",
  "title": "ResearchPlan",
  "description": "research plan artifact: a structured research plan derived from an opportunity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_plan_id",
    "project_id",
    "opportunity_id",
    "central_question"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "research_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "central_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "subquestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "maxLength": 32,
            "default": "contextual"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1
          }
        }
      },
      "default": []
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "depth": {
      "type": "string",
      "maxLength": 16,
      "default": "standard"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "target_audience": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
