{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/research_report.schema.json",
  "title": "ResearchReport",
  "description": "research -> research artifact: sources, claims, verification, and contradictions. Phase 0 fields preserved for backward compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_report_id",
    "topic",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "research_report_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "unverified"
            ],
            "default": "unverified"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "research_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "executive_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verified_claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/verifiedClaim"
      },
      "default": []
    },
    "contested_claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/verifiedClaim"
      },
      "default": []
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidenceItem"
      },
      "default": []
    },
    "source_list": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sourceItem"
      },
      "default": []
    },
    "source_quality": {
      "type": "object",
      "default": {}
    },
    "contradiction_details": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/contradictionDetail"
      },
      "default": []
    },
    "confidence_summary": {
      "type": "object",
      "default": {}
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "research_plan_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "depth": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "definitions": {
    "verifiedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "verification_status"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "claim_type": {
          "type": "string",
          "maxLength": 32,
          "default": "fact"
        },
        "importance": {
          "type": "string",
          "maxLength": 16,
          "default": "medium"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "supporting_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "contradicting_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "verification_status": {
          "type": "string",
          "maxLength": 32,
          "default": "UNVERIFIED"
        },
        "independent_source_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "value_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "claim"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "passage": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "value_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        }
      }
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "canonical_url",
        "url_fingerprint",
        "title",
        "source_type",
        "collection_status"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "canonical_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "url_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_type": {
          "type": "string",
          "maxLength": 32,
          "default": "unknown"
        },
        "discovery_query": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "authority_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "authority_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "collection_status": {
          "type": "string",
          "maxLength": 32,
          "default": "pending"
        },
        "collection_error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "byte_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "contradictionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id",
        "contradiction_type",
        "description"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0"
        },
        "contradiction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contradiction_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "resolution_status": {
          "type": "string",
          "maxLength": 32,
          "default": "unresolved"
        },
        "stronger_authority_source_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    }
  }
}
