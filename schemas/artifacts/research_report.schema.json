{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/research_report.schema.json",
  "title": "ResearchReport",
  "description": "research -> research artifact: sources, claims, and contradictions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_report_id",
    "topic",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "research_report_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "support_status"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "unverified"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "default": "1.0.0"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
