{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-youtube-autonomous-factory/schemas/artifacts/research_claim.schema.json",
  "title": "VerifiedClaim",
  "description": "research claim contract: a normalized claim with verification status and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "claim_type": {
      "type": "string",
      "maxLength": 32,
      "default": "fact"
    },
    "importance": {
      "type": "string",
      "maxLength": 16,
      "default": "medium"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "supporting_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "contradicting_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    },
    "verification_status": {
      "type": "string",
      "maxLength": 32,
      "default": "UNVERIFIED"
    },
    "independent_source_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "predicate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "value_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    }
  }
}
